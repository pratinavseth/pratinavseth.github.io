---
import { site } from '../config/site';

const subject = encodeURIComponent('Hello from your website');
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div>
      <h2 id="contact-title">Let’s talk.</h2>
      <p style="font-size:var(--step-1);max-width:40ch;margin-top:var(--space-4)">
        I’m always up for a conversation about post-training safety, interpretability, and turning research into systems
        people actually use. If something here overlaps with what you’re working on, write to me.
      </p>
      <p class="mono" style="text-transform:uppercase;letter-spacing:.05em;font-size:var(--step--1)">
        Open to: {site.openTo.join(' · ')}
      </p>
      <div class="btn-row" style="margin-top:var(--space-5)">
        <a class="btn btn--primary" href={`mailto:${site.email}?subject=${subject}`}>Email me</a>
        <a class="btn" href={site.links.linkedin}>LinkedIn</a>
        <a class="btn" href={site.cv}>CV (PDF)</a>
      </div>
    </div>
    <div>
      <p class="contact__note">
        <strong>Students &amp; early-career researchers:</strong> I can occasionally advise. A short note on who you are,
        what you’re working on, and the specific question you have goes a long way.
      </p>
      <p class="contact__note">
        <strong>Roles at Lexsi Labs:</strong> please apply directly through <a href="https://lexsi.ai">lexsi.ai</a> rather
        than asking me for referrals.
      </p>
    </div>
  </div>
</section>
