---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="page-head container" style="padding-bottom:var(--space-8)">
    <h1>404</h1>
    <p>That page isn’t here. It may have moved when the site was rebuilt.</p>
    <div class="btn-row" style="margin-top:var(--space-5)">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn" href="/publications/">Publications</a>
    </div>
  </section>
</Base>
