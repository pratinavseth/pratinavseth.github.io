---
import '@fontsource/archivo-black/400.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { site, nav } from '../config/site';
import { getPosts } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  /** Path of the share image, e.g. /og/home.png */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** JSON-LD objects for this page. */
  jsonLd?: object[];
  /** Extra <meta> tags, e.g. Google Scholar citation_* tags on paper pages. */
  meta?: { name: string; content: string }[];
  noindex?: boolean;
}

const { title, description, image = '/og/home.png', imageAlt = `${site.name}, ${site.role} at ${site.org}`, type = 'website', jsonLd = [], meta = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
const fullTitle =
  title === site.name ? `${site.name} · ${site.tagline}` : title.length > 45 ? title : `${title} · ${site.name}`;
const path = Astro.url.pathname;
// Writing appears in the menu once there is at least one published post.
const hasPosts = (await getPosts()).some((p) => !p.data.draft);
const menu = nav.filter((item) => item.href !== '/writing/' || hasPosts);
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <meta name="theme-color" content="#f4f4f0" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pratinavseth" />
    <meta name="twitter:creator" content="@pratinavseth" />

    {meta.map((m) => <meta name={m.name} content={m.content} />)}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {site.goatcounter && (
      <script is:inline data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__name" href="/">{site.name}</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {menu.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <p class="muted" style="margin:0">© {new Date().getFullYear()} {site.name}. {site.role}, {site.org}.</p>
        <ul aria-label="Profiles">
          <li><a href={`mailto:${site.email}`}>Email</a></li>
          <li><a href={site.links.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={site.links.scholar} rel="me">Scholar</a></li>
          <li><a href={site.links.github} rel="me">GitHub</a></li>
          <li><a href={site.links.twitter} rel="me">X</a></li>
          <li><a href={site.links.orcid} rel="me">ORCID</a></li>
          <li><a href={site.links.dblp}>DBLP</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const menu = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        menu?.setAttribute('data-open', String(open));
      });
    </script>
  </body>
</html>
